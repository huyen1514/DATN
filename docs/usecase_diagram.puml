@startuml
title Japanese Learning System - Use Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkOrange
  ArrowColor DarkSlateGray
  ActorBackgroundColor LightSkyBlue
  ActorBorderColor Navy
}
skinparam rectangle {
  BackgroundColor AliceBlue
  BorderColor SteelBlue
}

' ============================================================
' ACTORS
' ============================================================
actor "Khách (Guest)" as Guest
actor "Học viên (Student)" as Student
actor "Admin" as Admin
actor "VNPay Gateway" as VNPay <<external>>
actor "Momo Gateway" as Momo <<external>>
actor "Gemini AI" as GeminiAI <<external>>

Student --|> Guest

' ============================================================
' SYSTEM BOUNDARY
' ============================================================
rectangle "Japanese Learning System" {

  ' -----------------------------------------------
  ' UC GROUP: Xác thực & Tài khoản
  ' -----------------------------------------------
  package "Xác thực & Tài khoản" {
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Đăng nhập" as UC_Login
    usecase "Quên mật khẩu (gửi OTP)" as UC_ForgotPassword
    usecase "Xác nhận mã OTP" as UC_VerifyOTP
    usecase "Đặt lại mật khẩu" as UC_ResetPassword
    usecase "Xem thông tin cá nhân" as UC_ViewProfile
  }

  ' -----------------------------------------------
  ' UC GROUP: Học nội dung (Vocabulary, Kanji, Grammar, Reading, Listening)
  ' -----------------------------------------------
  package "Học Nội Dung" {
    usecase "Xem danh sách bài học theo cấp độ" as UC_ViewLessons
    usecase "Học từ vựng" as UC_LearnVocab
    usecase "Học Kanji" as UC_LearnKanji
    usecase "Học ngữ pháp" as UC_LearnGrammar
    usecase "Luyện đọc (Reading)" as UC_LearnReading
    usecase "Luyện nghe (Listening)" as UC_LearnListening
    usecase "Đánh dấu bookmark nội dung" as UC_Bookmark
    usecase "Xem danh sách bookmark" as UC_ViewBookmarks
    usecase "Theo dõi tiến trình học bài" as UC_TrackProgress
  }

  ' -----------------------------------------------
  ' UC GROUP: Flashcard (tự tạo)
  ' -----------------------------------------------
  package "Quản lý Flashcard" {
    usecase "Tạo Folder chứa Deck" as UC_CreateFolder
    usecase "Xem / Sửa / Xóa Folder" as UC_ManageFolder
    usecase "Tạo Deck flashcard" as UC_CreateDeck
    usecase "Xem / Sửa / Xóa Deck" as UC_ManageDeck
    usecase "Thêm Flashcard vào Deck" as UC_AddFlashcard
    usecase "Sửa / Xóa Flashcard" as UC_EditFlashcard
    usecase "Ôn tập Flashcard (SRS)" as UC_ReviewFlashcard
  }

  ' -----------------------------------------------
  ' UC GROUP: Prebuilt Flashcard (từ bài học)
  ' -----------------------------------------------
  package "Flashcard từ Bài Học" {
    usecase "Xem danh sách bài học có flashcard" as UC_ViewPrebuiltLessons
    usecase "Bắt đầu học Vocab/Kanji từ bài" as UC_StartPrebuiltDeck
    usecase "Hệ thống tự tạo deck & flashcard" as UC_AutoGenerateDeck
  }

  ' -----------------------------------------------
  ' UC GROUP: Thi thử (Exam)
  ' -----------------------------------------------
  package "Thi Thử JLPT" {
    usecase "Xem danh sách đề thi" as UC_ViewExams
    usecase "Xem chi tiết đề thi" as UC_ViewExamDetail
    usecase "Mua quyền làm đề thi" as UC_PurchaseExam
    usecase "Bắt đầu phiên thi" as UC_StartExamSession
    usecase "Nộp bài thi" as UC_SubmitExam
    usecase "Xem kết quả thi" as UC_ViewExamResult
  }

  ' -----------------------------------------------
  ' UC GROUP: Thanh toán
  ' -----------------------------------------------
  package "Thanh Toán" {
    usecase "Thanh toán qua VNPay" as UC_PayVNPay
    usecase "Thanh toán qua Momo" as UC_PayMomo
    usecase "Xử lý callback thanh toán" as UC_HandlePaymentCallback
    usecase "Mở khóa đề thi sau thanh toán" as UC_UnlockExam
  }

  ' -----------------------------------------------
  ' UC GROUP: Tổng quan & Khuyến nghị
  ' -----------------------------------------------
  package "Tổng Quan & Gợi Ý" {
    usecase "Xem dashboard học tập" as UC_ViewDashboard
    usecase "Nhận gợi ý học tập từ AI" as UC_GetRecommendation
    usecase "Xem lịch sử hoạt động" as UC_ViewRecentProgress
  }

  ' -----------------------------------------------
  ' UC GROUP: Admin - Quản trị hệ thống
  ' -----------------------------------------------
  package "Quản Trị Hệ Thống (Admin)" {
    usecase "Quản lý người dùng" as UC_ManageUsers
    usecase "Tạo tài khoản Admin" as UC_CreateAdmin
    usecase "Quản lý cấp độ (Level)" as UC_ManageLevels
    usecase "Quản lý bài học" as UC_ManageLessons
    usecase "Quản lý từ vựng" as UC_ManageVocab
    usecase "Quản lý Kanji" as UC_ManageKanji
    usecase "Quản lý ngữ pháp" as UC_ManageGrammar
    usecase "Quản lý bài đọc" as UC_ManageReadings
    usecase "Quản lý bài nghe" as UC_ManageListenings
    usecase "Tạo / Sửa / Xóa đề thi" as UC_ManageExams
    usecase "Import đề thi từ JSON" as UC_ImportExamJSON
    usecase "Upload media câu hỏi" as UC_UploadMedia
    usecase "Quản lý giao dịch thanh toán" as UC_ManagePayments
    usecase "Xem thống kê Admin Dashboard" as UC_AdminDashboard
  }

}

' ============================================================
' GUEST RELATIONSHIPS
' ============================================================
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_ForgotPassword
UC_ForgotPassword ..> UC_VerifyOTP : <<include>>
UC_VerifyOTP ..> UC_ResetPassword : <<include>>
Guest --> UC_ViewLessons
Guest --> UC_ViewExams

' ============================================================
' STUDENT RELATIONSHIPS
' ============================================================
Student --> UC_ViewProfile

' Học nội dung
Student --> UC_LearnVocab
Student --> UC_LearnKanji
Student --> UC_LearnGrammar
Student --> UC_LearnReading
Student --> UC_LearnListening
Student --> UC_Bookmark
Student --> UC_ViewBookmarks
Student --> UC_TrackProgress

UC_LearnVocab ..> UC_TrackProgress : <<extend>>
UC_LearnKanji ..> UC_TrackProgress : <<extend>>
UC_LearnGrammar ..> UC_TrackProgress : <<extend>>
UC_LearnReading ..> UC_TrackProgress : <<extend>>
UC_LearnListening ..> UC_TrackProgress : <<extend>>

' Flashcard tự tạo
Student --> UC_CreateFolder
Student --> UC_ManageFolder
Student --> UC_CreateDeck
Student --> UC_ManageDeck
Student --> UC_AddFlashcard
Student --> UC_EditFlashcard
Student --> UC_ReviewFlashcard

UC_CreateDeck ..> UC_CreateFolder : <<extend>>

' Prebuilt Flashcard
Student --> UC_ViewPrebuiltLessons
Student --> UC_StartPrebuiltDeck
UC_StartPrebuiltDeck ..> UC_AutoGenerateDeck : <<include>>

' Thi thử
Student --> UC_ViewExamDetail
Student --> UC_PurchaseExam
UC_PurchaseExam ..> UC_PayVNPay : <<extend>>
UC_PurchaseExam ..> UC_PayMomo : <<extend>>
UC_PayVNPay ..> UC_HandlePaymentCallback : <<include>>
UC_PayMomo ..> UC_HandlePaymentCallback : <<include>>
UC_HandlePaymentCallback ..> UC_UnlockExam : <<include>>

Student --> UC_StartExamSession
UC_StartExamSession ..> UC_PurchaseExam : <<extend>>
Student --> UC_SubmitExam
UC_SubmitExam ..> UC_ViewExamResult : <<include>>

' Tổng quan
Student --> UC_ViewDashboard
Student --> UC_GetRecommendation
Student --> UC_ViewRecentProgress

' ============================================================
' ADMIN RELATIONSHIPS
' ============================================================
Admin --> UC_ManageUsers
Admin --> UC_CreateAdmin
Admin --> UC_ManageLevels
Admin --> UC_ManageLessons
Admin --> UC_ManageVocab
Admin --> UC_ManageKanji
Admin --> UC_ManageGrammar
Admin --> UC_ManageReadings
Admin --> UC_ManageListenings
Admin --> UC_ManageExams
Admin --> UC_ImportExamJSON
Admin --> UC_UploadMedia
Admin --> UC_ManagePayments
Admin --> UC_AdminDashboard

UC_ImportExamJSON ..> UC_ManageExams : <<extend>>
UC_UploadMedia ..> UC_ManageExams : <<extend>>

' ============================================================
' EXTERNAL ACTOR RELATIONSHIPS
' ============================================================
VNPay --> UC_HandlePaymentCallback
Momo --> UC_HandlePaymentCallback
GeminiAI --> UC_GetRecommendation

@enduml
